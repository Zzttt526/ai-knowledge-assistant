# Application
APP_NAME=AI Knowledge Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Embedding provider
LLM_API_KEY=
MODEL_NAME=BAAI/bge-small-zh
# Allows deterministic local embeddings if the model is unavailable. Disable in production.
EMBEDDING_ALLOW_FALLBACK=true

# LLM provider. Set LLM_MODE=mock to avoid external API calls.
LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_ALLOW_MOCK_FALLBACK=true

# Storage
VECTOR_DB_PATH=./data/vector
UPLOAD_DIR=./data/uploads
VECTOR_COLLECTION=knowledge_base
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=500
CHUNK_OVERLAP=80
APP_DATABASE_PATH=./data/app.db
JWT_SECRET_KEY=change-this-in-production
JWT_EXPIRE_MINUTES=1440
